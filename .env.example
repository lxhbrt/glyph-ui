# Optional environment variables for Grok Build Terminal
# Copy to .env and adjust (never commit .env)

# Bridge / production port model
# Prod (npm start, LaunchAgent): UI + API + WS on one port
# PORT=5174
# HOST=127.0.0.1
# Dev: Vite UI on 5173 proxies /api and /ws → 5174

# Workspace for new ACP sessions
# GROK_CHAT_CWD=/path/to/your/project

# Grok CLI
# GROK_BIN=grok
# GROK_HOME=~/.grok

# UI state & wiki archive
# GROK_CHAT_STATE_DIR=~/.grok-chat-ui
# OPENCLAW_WIKI_PATH=~/ObsidianVaults/OpenClaw memory-wiki

# Voice (STT/TTS) — https://console.x.ai
# XAI_API_KEY=xai-...
# GROK_TTS_VOICE=eve
# GROK_STT_LANGUAGE=de
# GROK_TTS_LANGUAGE=de
