# Optional environment variables for Glyph (Build Term for Grok)
# Copy to .env and adjust (never commit .env).
# Loaded by npm start / npm run dev / LaunchAgent via Node --env-file-if-exists.

# Bridge / production port model
# Prod (npm start, LaunchAgent): UI + API + WS on one port
# PORT=5174
# HOST=127.0.0.1
# Dev: Vite UI on 5173 proxies /api and /ws → 5174

# Workspace for new ACP sessions
# GLYPH_UI_CWD=/path/to/your/project

# Grok CLI
# GROK_BIN=grok
# GROK_HOME=~/.grok

# UI state & wiki archive
# GLYPH_UI_STATE_DIR=~/.glyph-ui
# Default wiki archive: ~/.glyph-ui/wiki
# Point at an Obsidian vault (or any folder) if you want archives there instead:
# OPENCLAW_WIKI_PATH=~/path/to/your/vault

# Attachments
# GLYPH_UI_MAX_ATTACHMENT=12582912

# Security (default: loopback only)
# GLYPH_ALLOW_REMOTE=1

# Voice (STT/TTS) — https://console.x.ai
# XAI_API_KEY=xai-...
# GROK_TTS_VOICE=eve
# GROK_STT_LANGUAGE=de
# GROK_TTS_LANGUAGE=de

# OpenRouter (^_Code / °_Agent Cloud-Antwort) — https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-5.6-luna
# OPENROUTER_URL=https://openrouter.ai/api/v1
#
# Keys können auch in der UI unter Buch → Anbindung gesetzt werden:
#   ~/.glyph-ui/bindings.json  (lokal, nicht committen)
# Env-Variablen hier haben Vorrang, wenn sie beim Start bereits gesetzt sind.
# GLYPH_AGENT_URL=http://127.0.0.1:18899
