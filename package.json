{
  "name": "glyph",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Glyph UI \u2014 Build Term for Grok (independent browser UI via ACP).",
  "author": {
    "name": "Lx Hbrt",
    "url": "https://github.com/lxhbrt"
  },
  "contributors": [
    {
      "name": "Lx Hbrt",
      "url": "https://github.com/lxhbrt"
    }
  ],
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Alexander Hubert",
  "homepage": "https://github.com/lxhbrt/glyph-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxhbrt/glyph-ui.git"
  },
  "bugs": {
    "url": "https://github.com/lxhbrt/glyph-ui/issues"
  },
  "keywords": [
    "glyph",
    "grok",
    "grok-build",
    "build-term",
    "acp",
    "agent-client-protocol",
    "chat-ui",
    "coding-agent",
    "xai"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test:unit": "node --test tests/unit/*.test.js",
    "test": "npm run test:unit && npm run smoke",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "service:start": "bash scripts/start-service.sh",
    "service:install": "bash scripts/install-service.sh",
    "service:uninstall": "bash scripts/uninstall-service.sh",
    "service:status": "bash scripts/status-service.sh",
    "icon:dock": "bash scripts/install-dock-icon.sh",
    "open": "bash \"scripts/Open Glyph.command\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "vite": "^7.0.6"
  }
}
