{
  "name": "grok-chat-ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Grok Build Terminal \u2014 browser UI for Grok Build via ACP. By Lx Hbrt.",
  "author": {
    "name": "Lx Hbrt",
    "url": "https://github.com/lxhbrt"
  },
  "contributors": [
    {
      "name": "Lx Hbrt",
      "url": "https://github.com/lxhbrt"
    }
  ],
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Alexander Hubert",
  "homepage": "https://github.com/lxhbrt/grok-chat-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxhbrt/grok-chat-ui.git"
  },
  "bugs": {
    "url": "https://github.com/lxhbrt/grok-chat-ui/issues"
  },
  "keywords": [
    "grok",
    "grok-build",
    "acp",
    "agent-client-protocol",
    "chat-ui",
    "coding-agent",
    "xai"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node server/index.js",
    "service:start": "bash scripts/start-service.sh",
    "service:install": "bash scripts/install-service.sh",
    "service:uninstall": "bash scripts/uninstall-service.sh",
    "service:status": "bash scripts/status-service.sh",
    "icon:dock": "bash scripts/install-dock-icon.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "express": "^5.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.0.6"
  }
}
